<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>DRX to LUT</title>
    <license file="license.txt"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
    <domains enable_anywhere="false" enable_localSystem="true"/>
    <choices-outline><line choice="default"><line choice="dev.gordas.DRXtoLUT.pkg"/></line></choices-outline>
    <choice id="default"/>
    <choice id="dev.gordas.DRXtoLUT.pkg" visible="false"><pkg-ref id="dev.gordas.DRXtoLUT.pkg"/></choice>
    <pkg-ref id="dev.gordas.DRXtoLUT.pkg" version="@VERSION@" onConclusion="none">DRXtoLUT-component.pkg</pkg-ref>
</installer-gui-script>
